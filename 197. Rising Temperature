Solution Using Window Function Approach (LAG) in PYSPARK

from pyspark.sql import functions as F
from pyspark.sql.window import Window

window_spec = Window.orderBy("recordDate")

result = (
    weather
    .withColumn(
        "prev_date",
        F.lag("recordDate").over(window_spec)
    )
    .withColumn(
        "prev_temp",
        F.lag("temperature").over(window_spec)
    )
    .filter(
        (F.datediff(F.col("recordDate"), F.col("prev_date")) == 1)
        & (F.col("temperature") > F.col("prev_temp"))
    )
    .select("id")
)

result.show()

