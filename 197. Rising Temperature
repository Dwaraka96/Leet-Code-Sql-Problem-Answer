Solution using Self Join Approach in Pyspark

from pyspark.sql import functions as F

result = (
    weather.alias("w1")
    .join(
        weather.alias("w2"),
        F.col("w1.recordDate")
        == F.date_add(F.col("w2.recordDate"), 1),
        "inner"
    )
    .filter(
        F.col("w1.temperature") > F.col("w2.temperature")
    )
    .select(F.col("w1.id"))
)

result.show()

