Panda Solution::

import pandas as pd
import numpy as np

transactions['month'] = pd.to_datetime(
    transactions['trans_date']
).dt.strftime('%Y-%m')

transactions['approved_count'] = np.where(
    transactions['state'] == 'approved', 1, 0
)

transactions['approved_amount'] = np.where(
    transactions['state'] == 'approved',
    transactions['amount'],
    0
)

result = (
    transactions
    .groupby(['month', 'country'], as_index=False)
    .agg(
        trans_count=('id', 'count'),
        approved_count=('approved_count', 'sum'),
        trans_total_amount=('amount', 'sum'),
        approved_total_amount=('approved_amount', 'sum')
    )
)

print(result)
