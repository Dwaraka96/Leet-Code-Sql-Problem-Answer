Pyspark Solution:

from pyspark.sql import functions as F

result = (
    transactions
    .withColumn("month", F.date_format("trans_date", "yyyy-MM"))
    .groupBy("month", "country")
    .agg(
        F.count("*").alias("trans_count"),
        F.expr("sum(case when state = 'approved' then 1 else 0 end)").alias("approved_count"),
        F.sum("amount").alias("trans_total_amount"),
        F.expr("sum(case when state = 'approved' then amount else 0 end)").alias("approved_total_amount")
    )
)

result.show()
